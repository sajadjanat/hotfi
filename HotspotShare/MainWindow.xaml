<Window x:Class="HotspotShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOTFI"
        Icon="Assets/app.ico"
        Height="680" Width="440"
        FlowDirection="RightToLeft"
        FontFamily="pack://application:,,,/Assets/#Vazirmatn"
        FontSize="14"
        Background="#0B0620"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F1FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A89FC9"/>
        <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Magenta" Color="#EC4899"/>
        <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>

        <LinearGradientBrush x:Key="AuraGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#C026D3" Offset="0.5"/>
            <GradientStop Color="#22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AuraGradientDim" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A2E55" Offset="0"/>
            <GradientStop Color="#352A4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GalaxyBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#120A2E" Offset="0"/>
            <GradientStop Color="#1B0F3D" Offset="0.45"/>
            <GradientStop Color="#0E0822" Offset="0.8"/>
            <GradientStop Color="#05030F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardFill" Color="#1C1336" Opacity="0.72"/>
        <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6D44C7" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="AuraCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuraButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource AuraGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C026D3" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource AuraGradientDim}"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuraButtonOutline" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#241A42" BorderBrush="{StaticResource Cyan}" BorderThickness="1.2" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E2152"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuraTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1333"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderBrush" Value="#3D2E66"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6">
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="19" HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Galaxy background -->
        <Rectangle Fill="{StaticResource GalaxyBackground}"/>

        <!-- Starfield -->
        <Canvas x:Name="StarCanvas" IsHitTestVisible="False"/>

        <!-- Soft aura glow blobs -->
        <Ellipse Width="260" Height="260" Margin="-80,-100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="300" Height="300" Margin="0,0,-120,-140" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D3EE" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pages -->
            <Grid Grid.Row="0" Margin="20,20,20,8">

                <!-- Home page -->
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16">
                        <TextBlock Text="✦" Foreground="{StaticResource Cyan}" FontSize="20" Margin="6,0"/>
                        <TextBlock Text="HOTFI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="✦" Foreground="{StaticResource Magenta}" FontSize="20" Margin="6,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource AuraCard}">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="وضعیت: خاموش" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClientCountText" Text="۰ دستگاه متصل" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button x:Name="ToggleButton" Content="روشن کردن هات‌اسپات" Style="{StaticResource AuraButton}" Click="ToggleButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource AuraCard}">
                        <StackPanel>
                            <TextBlock Text="ترافیک اینترنت" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="⬇ سرعت دانلود" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="DownloadSpeedText" Text="۰ KB/s" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="⬆ سرعت آپلود" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="UploadSpeedText" Text="۰ KB/s" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Magenta}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="#3D2E66" Margin="0,14,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="مجموع دانلود" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TotalDownloadText" Text="۰ MB" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="مجموع آپلود" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TotalUploadText" Text="۰ MB" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Devices page -->
                <Grid x:Name="DevicesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="DevicesHeaderText" Text="دستگاه‌های متصل" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="2,8,0,12"/>

                    <Border Grid.Row="1" Style="{StaticResource AuraCard}" Padding="10">
                        <Grid>
                            <ItemsControl x:Name="DevicesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#241A42" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📱" FontSize="16" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding HostName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12">
                                                    <Run Text="IP: "/><Run Text="{Binding IpAddress}" Foreground="{StaticResource Cyan}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12">
                                                    <Run Text="MAC: "/><Run Text="{Binding MacAddress}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11">
                                                    <Run Text="متصل از: "/><Run Text="{Binding ConnectedSince, StringFormat='HH:mm:ss'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoDevicesText" Text="هیچ دستگاهی متصل نیست" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings page -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تنظیمات شبکه" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="2,8,0,12"/>

                    <Border Grid.Row="1" Style="{StaticResource AuraCard}">
                        <StackPanel>
                            <TextBlock Text="نام شبکه (SSID)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,4"/>
                            <TextBox x:Name="SsidBox" Style="{StaticResource AuraTextBox}" Margin="0,0,0,14"/>
                            <TextBlock Text="رمز عبور (حداقل ۸ کاراکتر)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,4"/>
                            <TextBox x:Name="PasswordBox" Style="{StaticResource AuraTextBox}" Margin="0,0,0,16"/>
                            <Button x:Name="SaveConfigButton" Content="ذخیره تنظیمات" Style="{StaticResource AuraButtonOutline}" Click="SaveConfigButton_Click"/>
                            <TextBlock x:Name="ConfigMessage" Foreground="#FF7AB8" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- QR page -->
                <Grid x:Name="QrPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="اتصال با اسکن QR" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="2,8,0,12"/>

                    <Border Grid.Row="1" Style="{StaticResource AuraCard}" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="White" CornerRadius="14" Padding="14" HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="220" Height="220"/>
                            </Border>
                            <TextBlock x:Name="QrSsidText" Text="Sajad" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                            <TextBlock Text="دوربین گوشی را روی این کد بگیرید تا خودکار به این هات‌اسپات وصل شوید"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" Width="240" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- Bottom nav -->
            <Border Grid.Row="1" Background="#160E30" BorderBrush="#3D2E66" BorderThickness="0,1,0,0">
                <UniformGrid Columns="4" Height="64">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavTabButton}" Tag="🏠" Content="خانه" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavTabButton}" Tag="📶" Content="دستگاه‌ها" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTabButton}" Tag="⚙️" Content="تنظیمات" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavQr" Style="{StaticResource NavTabButton}" Tag="🔗" Content="QR" Checked="Nav_Checked"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
